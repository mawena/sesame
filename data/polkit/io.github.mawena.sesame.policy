<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Sésame</vendor>
  <vendor_url>https://github.com/mawena/sesame</vendor_url>
  <action id="io.github.mawena.sesame.racine">
    <description>Configurer la connexion Microsoft Entra avec Sésame</description>
    <message>Une authentification est nécessaire pour modifier les comptes et la connexion du poste (Sésame).</message>
    <icon_name>io.github.mawena.Sesame</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sesame/sesame-racine</annotate>
  </action>
</policyconfig>
